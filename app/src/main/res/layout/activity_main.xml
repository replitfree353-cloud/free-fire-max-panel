<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0D0D0D"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FREE FIRE MAX"
        android:textColor="#FF4444"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HEADSHOT PANEL"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="250dp"
        android:layout_height="56dp"
        android:text="START PANEL"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FF2222"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnStop"
        android:layout_width="250dp"
        android:layout_height="56dp"
        android:text="STOP PANEL"
        android:textColor="#FFFFFF"
        android:backgroundTint="#333333"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnAccessibility"
        android:layout_width="250dp"
        android:layout_height="56dp"
        android:text="ENABLE ACCESSIBILITY"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1A73E8"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1. Grant Overlay\n2. Enable Accessibility\n3. Start Panel\n4. Open Free Fire Max"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:gravity="center" />

</LinearLayout>
